{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push * --force*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
