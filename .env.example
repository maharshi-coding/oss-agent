# OSS-Agent environment configuration. Copy to .env and fill in.
# NEVER commit a real .env file. All values here are examples/placeholders.

# --- GitHub ---
# Personal access token used by the "api" GitHub adapter. The "gh" adapter uses
# the gh CLI's own auth instead and ignores this. The backend setting below,
# not an empty token, selects mock versus live GitHub access.
OSS_AGENT_GITHUB_TOKEN=

# GitHub integration backend: mock | gh | api
#   mock : in-memory adapter, no network (default; used by tests)
#   gh   : shells out to the authenticated `gh` CLI
#   api  : reserved; not implemented yet (use gh for live GitHub)
OSS_AGENT_GITHUB_BACKEND=mock

# Expected authenticated gh account, checked before publication when configured.
# Required for create --existing-pr; that PR and its head fork must be owned by
# this account. Check your local login with: gh api user --jq .login
OSS_AGENT_GITHUB_LOGIN=

# --- Agent runtime ---
# Agent backend: mock | claude
#   mock   : deterministic in-process agents (tests, e2e, offline dev)
#   claude : invokes the Claude Code CLI as a subprocess
OSS_AGENT_AGENT_BACKEND=mock

# Path to the Claude Code executable when using the "claude" backend.
OSS_AGENT_CLAUDE_BIN=claude

# Name and email recorded as both author and committer of contribution commits.
# These defaults are offline placeholders. Configure both locally before a real
# contribution; OSS-Agent verifies the actual new commit metadata before push.
# Existing PR commits are preserved rather than rewritten to change identity.
OSS_AGENT_GIT_AUTHOR_NAME=oss-agent
OSS_AGENT_GIT_AUTHOR_EMAIL=oss-agent@example.invalid

# --- Storage & runtime ---
# SQLite database URL for workflow state.
OSS_AGENT_DATABASE_URL=sqlite:///.oss-agent/oss_agent.db

# Root directory under which git worktrees are created.
OSS_AGENT_WORKTREE_ROOT=.oss-agent/worktrees

# --- Behavior tuning ---
OSS_AGENT_MAX_REVIEW_ITERATIONS=3
OSS_AGENT_MAX_DEBUG_ITERATIONS=3
OSS_AGENT_COMMAND_TIMEOUT_SECONDS=600
OSS_AGENT_GITHUB_MIN_INTERVAL_SECONDS=1.0
OSS_AGENT_LOG_LEVEL=INFO
OSS_AGENT_LOG_FORMAT=text   # text | json

# Protected branches that may never be pushed to (comma-separated).
OSS_AGENT_PROTECTED_BRANCHES=main,master,develop,release

# Keep false. Automatic merging is not implemented or exposed by OSS-Agent.
OSS_AGENT_ALLOW_AUTO_MERGE=false
